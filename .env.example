HR_MCP_HOST=127.0.0.1
HR_MCP_PORT=8765
# Required. Use mysql for intranet/real runs. Use dump only in explicit local tests.
HR_DATA_BACKEND=mysql

# Centerized HTTP-MCP auth. Do not commit real tokens.
HR_AUTH_TOKENS_PATH=config/auth_tokens.json
HR_ALLOWED_IP_CIDRS=127.0.0.1/32,10.0.0.0/8
HR_RATE_LIMIT_PER_MINUTE=60
HR_MAX_REQUEST_BYTES=1048576

# MySQL backend is used when HR_DATA_BACKEND=mysql.
HR_DB_HOST=127.0.0.1
HR_DB_PORT=3306
HR_DB_USER=readonly_user
HR_DB_PASSWORD=change-me-outside-git
HR_DB_NAME=devops

# Local development only. Bearer token auth is used when request headers exist.
HR_MOCK_IDENTITY_ENABLED=true
HR_MOCK_USER_ID=1
HR_MOCK_USER_NAME=Local HR Admin
HR_MOCK_USER_ROLE=HR_ADMIN
HR_MOCK_DEPARTMENT_ID=1
HR_MOCK_CLIENT_ID=local-dev
HR_MOCK_ACCESS_REASON=local development test
