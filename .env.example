HR_MCP_HOST=127.0.0.1
HR_MCP_PORT=8765
HR_DATA_BACKEND=dump

# Production Gateway deployments should set this on the HR MCP service and have
# the trusted API Gateway inject the matching X-Gateway-Secret header.
HR_GATEWAY_SHARED_SECRET=change-me-outside-git

# MySQL backend is used only when HR_DATA_BACKEND=mysql.
HR_DB_HOST=127.0.0.1
HR_DB_PORT=3306
HR_DB_USER=readonly_user
HR_DB_PASSWORD=change-me-outside-git
HR_DB_NAME=devops

# Local development only. Gateway deployments should pass headers instead.
HR_MOCK_IDENTITY_ENABLED=true
HR_MOCK_USER_ID=1
HR_MOCK_USER_NAME=Local HR Admin
HR_MOCK_USER_ROLE=HR_ADMIN
HR_MOCK_DEPARTMENT_ID=1
HR_MOCK_CLIENT_ID=local-dev
HR_MOCK_ACCESS_REASON=local development test
